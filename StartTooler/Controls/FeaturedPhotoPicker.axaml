<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:StartTooler.Models"
        xmlns:converters="using:StartTooler.Converters"
        xmlns:controls="using:StartTooler.Controls"
        mc:Ignorable="d"
        x:Class="StartTooler.Controls.FeaturedPhotoPicker"
        x:DataType="controls:FeaturedPhotoPicker"
        Title="管理精选照片"
        Width="720"
        Height="540"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource Bg.Surface}">

    <Window.Resources>
        <converters:StringToResourceConverter x:Key="StringToResource"/>
        <converters:FilePathToBitmapConverter x:Key="FilePathToBitmap"/>
    </Window.Resources>

    <Border Background="{DynamicResource Bg.Surface}"
            Padding="20">
        <Grid RowDefinitions="Auto,*,Auto,Auto"
              RowSpacing="16">

            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Path Data="{DynamicResource Icon.Photo}"
                          Width="16" Height="16"
                          Fill="{DynamicResource Text.Secondary}"
                          Stretch="Uniform"/>
                    <TextBlock Text="管理精选照片"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"/>
                    <Border Background="{DynamicResource Bg.Outer}"
                            CornerRadius="8"
                            Padding="6,2">
                        <TextBlock Text="{Binding Items.Count}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Classes="secondary-button"
                            Click="OnSelectAllClick"
                            Padding="10,6"
                            FontSize="12">
                        <TextBlock Text="全选"/>
                    </Button>
                    <Button Classes="secondary-button"
                            Click="OnClearAllClick"
                            Padding="10,6"
                            FontSize="12">
                        <TextBlock Text="清空"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PhotosItemsControl"
                              ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FeaturedPhotoSelectableItem">
                            <Button Width="100" Height="100"
                                    Margin="0,0,12,12"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnPhotoClick">
                                <Grid>
                                    <Border CornerRadius="8"
                                            ClipToBounds="True"
                                            Background="{DynamicResource Bg.Outer}"
                                            BorderBrush="{DynamicResource Bg.Divider}"
                                            BorderThickness="1">
                                        <Image Source="{Binding Photo.ThumbnailPath, Converter={StaticResource FilePathToBitmap}}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- 选中遮罩 -->
                                    <Border CornerRadius="8"
                                            Background="{DynamicResource Overlay.PhotoBadgeMedium}"
                                            IsVisible="{Binding IsSelected}"/>

                                    <!-- 选中勾 -->
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="32" Height="32"
                                            CornerRadius="16"
                                            Background="{DynamicResource Accent.Stellar}"
                                            IsVisible="{Binding IsSelected}">
                                        <Path Data="{DynamicResource Icon.Check}"
                                              Width="18" Height="18"
                                              Stroke="White"
                                              StrokeThickness="3"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 评分角标 -->
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Overlay.PhotoBadge}"
                                            CornerRadius="0,8,0,8"
                                            Padding="6,4"
                                            IsVisible="{Binding Photo.Score, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="{Binding Photo.Score}"
                                                   FontSize="11"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       Text="点击照片切换选中状态，保存后生效。"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Tertiary}"/>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Classes="secondary-button"
                        Click="OnCancelClick"
                        Padding="20,8">
                    <TextBlock Text="取消"/>
                </Button>
                <Button Classes="primary-button"
                        Click="OnSaveClick"
                        Padding="20,8">
                    <TextBlock Text="保存"/>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</Window>
