<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StartTooler.ViewModels"
             xmlns:models="using:StartTooler.Models"
             mc:Ignorable="d"
             x:Class="StartTooler.Controls.TimelineBar"
             x:DataType="vm:DiaryViewModel">

    <Border Background="{DynamicResource Bg.Outer}"
            BorderBrush="{DynamicResource Bg.Divider}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding TimelineDots}">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                </ItemsPanelTemplate>
                <DataTemplate DataType="models:TimelineDot">
                    <Button Classes="timeline-dot"
                            Command="{Binding $parent[ItemsControl].((vm:DiaryViewModel)DataContext).NavigateToPageCommand}"
                            CommandParameter="{Binding Index}"
                            Width="14" Height="14"
                            Padding="0"
                            Background="Transparent"
                            ToolTip.Tip="{Binding TooltipText}">
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding DotBrush, FallbackValue={DynamicResource Text.Tertiary}}"/>
                    </Button>
                </DataTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>