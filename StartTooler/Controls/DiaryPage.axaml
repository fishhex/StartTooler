<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:StartTooler.Data"
             xmlns:converters="using:StartTooler.Converters"
             xmlns:vm="using:StartTooler.ViewModels"
             xmlns:models="using:StartTooler.Models"
             mc:Ignorable="d"
             x:Class="StartTooler.Controls.DiaryPage"
             x:DataType="vm:DiaryViewModel">

    <UserControl.Resources>
        <converters:StringToResourceConverter x:Key="StringToResource"/>
        <converters:FilePathToBitmapConverter x:Key="FilePathToBitmap"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.featured-photo-button:pointerover Button.featured-remove-button">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="20" Margin="32">

            <!-- 头部 -->
            <Grid ColumnDefinitions="*,Auto">

                <!-- 左侧：日期、星期、标题、目标标签、天气/地点 -->
                <StackPanel Grid.Column="0" Spacing="8">

                    <!-- 面包屑 -->
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="DIARY"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Tertiary}"/>
                        <TextBlock Text="·"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"/>
                        <TextBlock Text="{Binding CurrentPage.WeekLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"/>
                    </StackPanel>

                    <!-- 大日期 -->
                    <Button Padding="0" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Left"
                            Command="{Binding NavigateToDateCommand}"
                            CommandParameter="{Binding CurrentPage.Date}"
                            ToolTip.Tip="在媒体库中查看这一天">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding CurrentPage.Date, StringFormat='{}{0:MM}'}"
                                       FontSize="64"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       LineHeight="64"/>
                            <TextBlock Text=" "
                                       FontSize="64"
                                       LineHeight="64"/>
                            <TextBlock Text="{Binding CurrentPage.Date, StringFormat='{}{0:dd}'}"
                                       FontSize="64"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       LineHeight="64"/>
                        </StackPanel>
                    </Button>

                    <!-- 标题 -->
                    <!-- 标题展示 -->
                    <Button Command="{Binding EditTitleCommand}"
                            Padding="0" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding CurrentPage.IsTitleDisplayVisible}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding CurrentPage.Title}"
                                       FontSize="14"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       VerticalAlignment="Center"/>
                            <Path Data="{DynamicResource Icon.Edit}" Width="12" Height="12"
                                  Fill="{DynamicResource Text.Tertiary}" Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 标题编辑 -->
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding CurrentPage.IsTitleEditVisible}">
                        <TextBox x:Name="TitleTextBox"
                                 Text="{Binding CurrentPage.EditableTitle, Mode=TwoWay}"
                                 FontSize="14"
                                 Foreground="{DynamicResource Text.Primary}"
                                 Background="{DynamicResource Bg.Outer}"
                                 BorderBrush="{DynamicResource Bg.Divider}"
                                 CornerRadius="4"
                                 Padding="8,4"
                                 MinWidth="200"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 LostFocus="OnTitleLostFocus"
                                 KeyDown="OnTitleKeyDown"/>
                        <Button Command="{Binding SaveTitleCommand}"
                                Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center">
                            <Path Data="{DynamicResource Icon.Check}"
                                  Width="14" Height="14"
                                  Stroke="{DynamicResource Text.Secondary}"
                                  StrokeThickness="2"
                                  Stretch="Uniform"/>
                        </Button>
                        <Button Command="{Binding CancelEditTitleCommand}"
                                Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center">
                            <Path Data="{DynamicResource Icon.X}"
                                  Width="14" Height="14"
                                  Fill="{DynamicResource Text.Tertiary}"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>

                    <!-- 星期 · 农历 -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding CurrentPage.WeekdayText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                        <TextBlock Text="·"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text.Tertiary}"/>
                        <TextBlock Text="{Binding CurrentPage.LunarDateText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>

                    <!-- 天气 + 地点 胶囊 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <!-- 天气胶囊：显示 -->
                        <Border Background="{DynamicResource Bg.Outer}"
                                CornerRadius="12"
                                Padding="8,4"
                                IsVisible="{Binding CurrentPage.WeatherText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Button Click="OnWeatherEditClick"
                                    Padding="0" Background="Transparent" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Width="14" Height="14"
                                          Data="{Binding CurrentPage.WeatherIconKey, Converter={StaticResource StringToResource}}"
                                          Fill="{DynamicResource Text.Secondary}"
                                          Stretch="Uniform"
                                          IsVisible="{Binding CurrentPage.WeatherIconKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding CurrentPage.WeatherText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- 添加天气按钮 -->
                        <Button Click="OnWeatherEditClick"
                                Padding="0" Background="Transparent" BorderThickness="0"
                                IsVisible="{Binding CurrentPage.WeatherText, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                            <Border Background="{DynamicResource Bg.Outer}"
                                    CornerRadius="12"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Data="{DynamicResource Icon.CloudSun}" Width="14" Height="14"
                                          Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                                    <TextBlock Text="添加天气"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- 地点胶囊：显示 -->
                        <Border Background="{DynamicResource Bg.Outer}"
                                CornerRadius="12"
                                Padding="8,4"
                                IsVisible="{Binding CurrentPage.IsLocationDisplayVisible}">
                            <Button Click="OnLocationEditClick"
                                    Padding="0" Background="Transparent" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Data="{DynamicResource Icon.Globe}" Width="12" Height="12"
                                          Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding CurrentPage.Location}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- 地点编辑框 -->
                        <Border Background="{DynamicResource Bg.Outer}"
                                CornerRadius="12"
                                Padding="8,4"
                                IsVisible="{Binding CurrentPage.IsLocationEditVisible}">
                            <TextBox x:Name="LocationTextBox"
                                     Text="{Binding CurrentPage.EditableLocation, Mode=TwoWay}"
                                     FontSize="12"
                                     Background="Transparent"
                                     BorderBrush="{DynamicResource Text.Secondary}"
                                     BorderThickness="0,0,0,1"
                                     Padding="8,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     MinWidth="80"
                                     CaretBrush="{DynamicResource Text.Primary}"
                                     LostFocus="OnLocationLostFocus"
                                     KeyDown="OnLocationKeyDown"/>
                        </Border>

                        <!-- 添加地点按钮 -->
                        <Button Click="OnLocationEditClick"
                                Padding="0" Background="Transparent" BorderThickness="0"
                                IsVisible="{Binding CurrentPage.IsAddLocationVisible}">
                            <Border Background="{DynamicResource Bg.Outer}"
                                    CornerRadius="12"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Data="{DynamicResource Icon.Globe}" Width="12" Height="12"
                                          Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                                    <TextBlock Text="添加地点"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：核心统计 -->
                <StackPanel Grid.Column="1"
                            Width="200"
                            Margin="24,0,0,0"
                            VerticalAlignment="Top"
                            Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="时段"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"/>

                        <!-- 时段展示 -->
                        <Button Command="{Binding EditPeriodCommand}"
                                Padding="0" Background="Transparent" BorderThickness="0"
                                IsVisible="{Binding CurrentPage.IsPeriodDisplayVisible}">
                            <TextBlock Text="{Binding CurrentPage.PeriodText}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent.Stellar}"/>
                        </Button>

                        <!-- 时段编辑 -->
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Bottom"
                                    IsVisible="{Binding CurrentPage.IsPeriodEditVisible}">
                            <TextBox Text="{Binding CurrentPage.EditableStartTime, Mode=TwoWay}"
                                     Watermark="开始"
                                     FontSize="16"
                                     Width="56"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="-"
                                       FontSize="16"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       VerticalAlignment="Center"/>
                            <TextBox Text="{Binding CurrentPage.EditableEndTime, Mode=TwoWay}"
                                     Watermark="结束"
                                     FontSize="16"
                                     Width="56"
                                     VerticalAlignment="Center"/>
                            <Button Command="{Binding SavePeriodCommand}"
                                    Padding="4,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center">
                                <Path Data="{DynamicResource Icon.Check}"
                                      Width="14" Height="14"
                                      Stroke="{DynamicResource Text.Secondary}"
                                      StrokeThickness="2"
                                      Stretch="Uniform"/>
                            </Button>
                            <Button Command="{Binding CancelEditPeriodCommand}"
                                    Padding="4,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center">
                                <Path Data="{DynamicResource Icon.X}"
                                      Width="14" Height="14"
                                      Fill="{DynamicResource Text.Tertiary}"
                                      Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="4">
                            <TextBlock Text="照片"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Tertiary}"/>
                            <StackPanel Orientation="Horizontal" Spacing="2"
                                        VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding CurrentPage.TotalPhotoCount}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock Text="张"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="目标"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Tertiary}"/>
                            <StackPanel Orientation="Horizontal" Spacing="2"
                                        VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding CurrentPage.TargetCount}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock Text="个"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Tertiary}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource Bg.Divider}"/>

            <!-- 精选照片区域 -->
            <StackPanel Spacing="12">

                <!-- 标题行 -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <Path Data="{DynamicResource Icon.Photo}" Width="16" Height="16"
                              Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                        <TextBlock Text="精选照片"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <Border Background="{DynamicResource Bg.Outer}"
                                CornerRadius="8"
                                Padding="6,2">
                            <TextBlock Text="{Binding CurrentPage.FeaturedPhotos.Count}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <ComboBox FontSize="12"
                                  VerticalAlignment="Center"
                                  SelectedIndex="{Binding CurrentPage.FeaturedSortModeIndex}">
                            <ComboBoxItem Content="按拍摄时间升序"/>
                            <ComboBoxItem Content="按拍摄时间降序"/>
                            <ComboBoxItem Content="按评分排序"/>
                        </ComboBox>
                        <Button Classes="secondary-button"
                                Command="{Binding OpenFeaturedPhotoPickerCommand}"
                                ToolTip.Tip="管理本会话的精选照片">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{DynamicResource Icon.Photo}" Width="12" Height="12"
                                      Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                                <TextBlock Text="管理精选" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 照片网格 + 查看全部 -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ItemsControl ItemsSource="{Binding CurrentPage.DisplayedFeaturedPhotos}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FeaturedPhotoItem">
                                <Button Width="120" Height="120"
                                        Margin="0,0,16,16"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Classes="featured-photo-button"
                                        Command="{Binding $parent[UserControl].DataContext.OpenPhotoCommand}"
                                        CommandParameter="{Binding Photo}">
                                    <Grid>
                                        <Border CornerRadius="8"
                                                ClipToBounds="True"
                                                Background="{DynamicResource Bg.Outer}">
                                            <Image Source="{Binding Photo.ThumbnailPath, Converter={StaticResource FilePathToBitmap}}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <!-- 编号 -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{DynamicResource Overlay.PhotoBadge}"
                                                CornerRadius="8,0,8,0"
                                                Padding="6,4">
                                            <TextBlock Text="{Binding IndexText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                        <!-- 时间戳 -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="{DynamicResource Overlay.PhotoBadge}"
                                                CornerRadius="8,0,8,0"
                                                Padding="6,4"
                                                IsVisible="{Binding TimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontSize="11"
                                                       Foreground="White"/>
                                        </Border>
                                        <!-- 移除按钮 -->
                                        <Button Classes="featured-remove-button"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Width="24" Height="24"
                                                Padding="0"
                                                Background="{DynamicResource Overlay.PhotoBadgeStrong}"
                                                BorderThickness="0"
                                                CornerRadius="12"
                                                Opacity="0"
                                                IsHitTestVisible="False"
                                                Command="{Binding $parent[UserControl].DataContext.RemoveFeaturedPhotoCommand}"
                                                CommandParameter="{Binding Photo}"
                                                ToolTip.Tip="从精选中移除">
                                            <Path Data="{DynamicResource Icon.X}"
                                                  Width="14" Height="14"
                                                  Fill="White"
                                                  Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 查看全部 -->
                    <Button Width="120" Height="120"
                            Margin="0,0,16,16"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding OpenPhotoCommand}"
                            CommandParameter="{Binding CurrentPage.FeaturedPhotos[0]}"
                            IsVisible="{Binding CurrentPage.HasMoreFeaturedPhotos}">
                        <Border Width="120" Height="120"
                                CornerRadius="8"
                                Background="{DynamicResource Bg.Outer}"
                                BorderBrush="{DynamicResource Bg.Divider}"
                                BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <Path Data="{DynamicResource Icon.ChevronRight}" Width="24" Height="24"
                                      Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                                <TextBlock Text="{Binding CurrentPage.HiddenFeaturedCount, StringFormat='查看全部 +{0}'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Bg.Divider}"/>

            <!-- 笔记 -->
            <StackPanel Spacing="12">

                <!-- 标题行 -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="拍摄笔记"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <Border Background="{DynamicResource Bg.Outer}"
                                CornerRadius="8"
                                Padding="6,2"
                                IsVisible="{Binding CurrentPage.NotesSaveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding CurrentPage.NotesSaveStatus}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Secondary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentPage.NotesCharacterCount, StringFormat='{}{0} / 500'}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Tertiary}"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBox Text="{Binding CurrentPage.Notes, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="120"
                         MaxHeight="240"
                         FontSize="14"
                         MaxLength="500"
                         Watermark="记录这次拍摄的所见所思…"
                         LostFocus="OnNotesLostFocus"
                         Background="{DynamicResource Bg.Outer}"
                         BorderBrush="{DynamicResource Bg.Divider}"
                         CornerRadius="8"
                         Padding="12"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Bg.Divider}"/>

            <!-- 常用标签 -->
            <StackPanel Spacing="8">
                <TextBlock Text="常用标签"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"/>
                <ItemsControl ItemsSource="{Binding CurrentPage.TopTags}"
                              IsVisible="{Binding CurrentPage.TopTags.Count, Converter={x:Static converters:Int32Converters.IsGreaterThanZero}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="0" Background="Transparent" BorderThickness="0"
                                    Command="{Binding $parent[UserControl].DataContext.NavigateToTagCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="在媒体库中按此标签筛选">
                                <Border Background="{DynamicResource Bg.Outer}"
                                        Padding="6,3"
                                        Margin="0,0,4,4"
                                        CornerRadius="10">
                                    <TextBlock Text="{Binding ., StringFormat='#{0}'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}"/>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
</UserControl>