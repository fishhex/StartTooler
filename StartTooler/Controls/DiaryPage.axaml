<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:StartTooler.Data"
             xmlns:converters="using:StartTooler.Converters"
             xmlns:vm="using:StartTooler.ViewModels"
             xmlns:models="using:StartTooler.Models"
             mc:Ignorable="d"
             x:Class="StartTooler.Controls.DiaryPage"
             x:DataType="vm:DiaryViewModel">

    <UserControl.Resources>
        <converters:StringToResourceConverter x:Key="StringToResource"/>
        <converters:FilePathToBitmapConverter x:Key="FilePathToBitmap"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource Bg.Surface}"
            BorderBrush="{DynamicResource Bg.Divider}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="32">
        <StackPanel Spacing="20">

            <!-- 头部 -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                <!-- 面包屑 -->
                <StackPanel Grid.Row="0" Grid.Column="0"
                            Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="DIARY"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Tertiary}"/>
                    <TextBlock Text="·"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}"/>
                    <TextBlock Text="{Binding CurrentPage.WeekLabel}"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="secondary-button"
                            Command="{Binding RefreshEnvironmentCommand}"
                            IsEnabled="{Binding IsRefreshingEnvironment, Converter={x:Static BoolConverters.Not}}"
                            ToolTip.Tip="从首张照片 GPS 重新获取地点和天气">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{DynamicResource Icon.Refresh}" Width="12" Height="12"
                                  Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                            <TextBlock Text="刷新环境" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="danger-button"
                            Command="{Binding DeleteCurrentSessionCommand}"
                            ToolTip.Tip="删除整个会话（其下照片 session_id 会被清空）">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{DynamicResource Icon.Trash}" Width="12" Height="12"
                                  Fill="{DynamicResource State.Danger}" Stretch="Uniform"/>
                            <TextBlock Text="删除会话" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 大日期 -->
                <Button Grid.Row="1" Grid.Column="0"
                        Padding="0" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left"
                        Command="{Binding NavigateToDateCommand}"
                        CommandParameter="{Binding CurrentPage.Date}"
                        ToolTip.Tip="在媒体库中查看这一天"
                        Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CurrentPage.Date, StringFormat='{}{0:MM}'}"
                                   FontSize="64"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   LineHeight="64"/>
                        <TextBlock Text=" "
                                   FontSize="64"
                                   LineHeight="64"/>
                        <TextBlock Text="{Binding CurrentPage.Date, StringFormat='{}{0:dd}'}"
                                   FontSize="64"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   LineHeight="64"/>
                    </StackPanel>
                </Button>

                <!-- 时长 -->
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding CurrentPage.DurationText}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,8"/>

                <!-- 星期 · 农历 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <TextBlock Text="{Binding CurrentPage.WeekdayText}"
                               FontSize="13"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock Text="·"
                               FontSize="13"
                               Foreground="{DynamicResource Text.Tertiary}"/>
                    <TextBlock Text="{Binding CurrentPage.LunarDateText}"
                               FontSize="13"
                               Foreground="{DynamicResource Text.Secondary}"/>
                </StackPanel>

                <!-- 标题 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding CurrentPage.Title}"
                           FontSize="14"
                           Foreground="{DynamicResource Text.Secondary}"
                           Margin="0,4,0,0"/>

                <!-- 目标标签 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding CurrentPage.TargetLabelsText}"
                           FontSize="13"
                           Foreground="{DynamicResource Text.Tertiary}"
                           Margin="0,8,0,0"
                           IsVisible="{Binding CurrentPage.TargetLabelsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- 天气 + 地点 胶囊 -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Border Background="{DynamicResource Bg.Outer}"
                            CornerRadius="12"
                            Padding="8,4"
                            IsVisible="{Binding CurrentPage.WeatherText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Width="14" Height="14"
                                  Data="{Binding CurrentPage.WeatherIconKey, Converter={StaticResource StringToResource}}"
                                  Fill="{DynamicResource Text.Secondary}"
                                  Stretch="Uniform"
                                  IsVisible="{Binding CurrentPage.WeatherIconKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding CurrentPage.WeatherText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Bg.Outer}"
                            CornerRadius="12"
                            Padding="8,4"
                            IsVisible="{Binding CurrentPage.Location, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Data="{DynamicResource Icon.Globe}" Width="12" Height="12"
                                  Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                            <TextBlock Text="{Binding CurrentPage.Location}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>

            <Border Height="1" Background="{DynamicResource Bg.Divider}"/>

            <!-- 精选照片区域 -->
            <StackPanel Spacing="12">

                <!-- 标题行 -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <Path Data="{DynamicResource Icon.Photo}" Width="16" Height="16"
                              Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                        <TextBlock Text="精选照片"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <Border Background="{DynamicResource Bg.Outer}"
                                CornerRadius="8"
                                Padding="6,2">
                            <TextBlock Text="{Binding CurrentPage.FeaturedPhotos.Count}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"/>
                        </Border>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              SelectedIndex="0"
                              FontSize="12"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="按拍摄时间排序"/>
                        <ComboBoxItem Content="按评分排序"/>
                    </ComboBox>
                </Grid>

                <!-- 照片网格 + 查看全部 -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ItemsControl ItemsSource="{Binding CurrentPage.DisplayedFeaturedPhotos}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FeaturedPhotoItem">
                                <Button Width="120" Height="120"
                                        Margin="0,0,16,16"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding $parent[UserControl].DataContext.OpenPhotoCommand}"
                                        CommandParameter="{Binding Photo}">
                                    <Grid>
                                        <Border CornerRadius="8"
                                                ClipToBounds="True"
                                                Background="{DynamicResource Bg.Outer}">
                                            <Image Source="{Binding Photo.ThumbnailPath, Converter={StaticResource FilePathToBitmap}}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <!-- 编号 -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="#80000000"
                                                CornerRadius="8,0,8,0"
                                                Padding="6,4">
                                            <TextBlock Text="{Binding IndexText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                        <!-- 时间戳 -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="#80000000"
                                                CornerRadius="8,0,8,0"
                                                Padding="6,4"
                                                IsVisible="{Binding TimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontSize="11"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 查看全部 -->
                    <Button Width="120" Height="120"
                            Margin="0,0,16,16"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding OpenPhotoCommand}"
                            CommandParameter="{Binding CurrentPage.FeaturedPhotos[0]}"
                            IsVisible="{Binding CurrentPage.HasMoreFeaturedPhotos}">
                        <Border Width="120" Height="120"
                                CornerRadius="8"
                                Background="{DynamicResource Bg.Outer}"
                                BorderBrush="{DynamicResource Bg.Divider}"
                                BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                <Path Data="{DynamicResource Icon.ChevronRight}" Width="24" Height="24"
                                      Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                                <TextBlock Text="{Binding CurrentPage.HiddenFeaturedCount, StringFormat='查看全部 +{0}'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Secondary}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

            </StackPanel>

            <Border Height="1" Background="{DynamicResource Bg.Divider}"/>

            <!-- 笔记 -->
            <StackPanel Spacing="12">

                <!-- 标题行 -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="拍摄笔记"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <Border Background="{DynamicResource Bg.Outer}"
                                CornerRadius="8"
                                Padding="6,2"
                                IsVisible="{Binding CurrentPage.NotesSaveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding CurrentPage.NotesSaveStatus}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Secondary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentPage.NotesCharacterCount, StringFormat='{}{0} / 500'}"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Tertiary}"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBox Text="{Binding CurrentPage.Notes, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="120"
                         MaxHeight="240"
                         FontSize="14"
                         MaxLength="500"
                         Watermark="记录这次拍摄的所见所思…"
                         LostFocus="OnNotesLostFocus"
                         Background="{DynamicResource Bg.Outer}"
                         BorderBrush="{DynamicResource Bg.Divider}"
                         CornerRadius="8"
                         Padding="12"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource Bg.Divider}"/>

            <!-- 统计条 -->
            <Grid ColumnDefinitions="*,*,*,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="拍摄张数"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CurrentPage.TotalPhotoCount}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="张"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="目标数"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CurrentPage.TargetCount}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"/>
                        <TextBlock Text="个"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="累计曝光"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}"/>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CurrentPage.TotalExposureHours, StringFormat='{}{0:F1}'}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#4FC3F7"/>
                        <TextBlock Text="h"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="4">
                    <TextBlock Text="常用标签"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}"/>
                    <ItemsControl ItemsSource="{Binding CurrentPage.TopTags}"
                                  IsVisible="{Binding CurrentPage.TopTags.Count, Converter={x:Static converters:Int32Converters.IsGreaterThanZero}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="0" Background="Transparent" BorderThickness="0"
                                        Command="{Binding $parent[UserControl].DataContext.NavigateToTagCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="在媒体库中按此标签筛选">
                                    <Border Background="{DynamicResource Bg.Outer}"
                                            Padding="6,3"
                                            Margin="0,0,4,4"
                                            CornerRadius="10">
                                        <TextBlock Text="{Binding ., StringFormat='#{0}'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text.Secondary}"/>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>