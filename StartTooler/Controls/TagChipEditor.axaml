<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:StartTooler.Controls"
             x:Class="StartTooler.Controls.TagChipEditor"
             x:DataType="controls:ITagEditorHost">

    <!--
      v0.12: tag chip 编辑器 + 自动补全下拉。
      候选数据在 code-behind 中填充到 SuggestionsList.ItemsSource。
    -->

    <StackPanel Spacing="8">

        <!-- chip 列表 -->
        <ItemsControl ItemsSource="{Binding Tags}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Classes="chip-removable"
                            Tag="{Binding}"
                            Click="OnChipClick"
                            ToolTip.Tip="点击删除">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Primary}"
                                       VerticalAlignment="Center" />
                            <PathIcon Data="{StaticResource Icon.X}"
                                      Width="8" Height="8"
                                      Classes="chip-x-icon"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 输入行：TextBox + chevron 按钮 -->
        <Grid ColumnDefinitions="*,Auto"
              IsVisible="{Binding ShowInputBox}">

            <TextBox Grid.Column="0"
                     x:Name="InputBox"
                     Text="{Binding NewTagInput, Mode=TwoWay}"
                     KeyDown="OnInputKeyDown"
                     GotFocus="OnInputGotFocus"
                     Watermark="{Binding Watermark}"
                     MaxLength="{Binding MaxTagLength}"
                     FontSize="12" />

            <Button Grid.Column="1"
                    x:Name="ChevronButton"
                    Classes="chevron-toggle"
                    Click="OnChevronClick"
                    ToolTip.Tip="展开标签候选"
                    Margin="4,0,0,0"
                    Width="24" Height="24"
                    Padding="0"
                    VerticalAlignment="Stretch">
                <PathIcon Data="{StaticResource Icon.ChevronDown}"
                          Width="12" Height="12"
                          Foreground="{DynamicResource Text.Secondary}" />
            </Button>

            <!-- 候选下拉 Popup -->
            <Popup x:Name="SuggestionsPopup"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True"
                   HorizontalOffset="0"
                   VerticalOffset="4">
                <Border Classes="suggestion-dropdown"
                        MinWidth="200"
                        x:Name="DropdownBorder">
                    <StackPanel>

                        <!-- 候选列表（ItemsSource 由 code-behind 设置，ScrollViewer 让超出条目可滚动） -->
                        <ScrollViewer MaxHeight="240"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SuggestionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="controls:SuggestionItem">
                                        <Button Classes="suggestion-row"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="8,5"
                                                Click="OnSuggestionClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UsageText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding ShowUsage}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 分隔线 -->
                        <Separator x:Name="SectionSeparator"
                                   Margin="8,4"
                                   IsVisible="False"
                                   Background="{DynamicResource Border.Strong}"
                                   Height="1" />

                        <!-- "＋ 新建" 行 -->
                        <Button x:Name="NewTagRow"
                                Classes="suggestion-row"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,5"
                                Click="OnNewTagClick"
                                IsVisible="False">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource Accent.Stellar}"
                                       VerticalAlignment="Center">
                                <Run Text="+ 新建 &quot;" />
                                <Run x:Name="NewTagNameRun" />
                                <Run Text="&quot;" />
                            </TextBlock>
                        </Button>

                        <!-- 底部提示 -->
                        <Border Padding="8,4">
                            <TextBlock FontSize="10"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       Text="↑↓ 选择  Enter 确认  Esc 关闭" />
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </StackPanel>
</UserControl>
