<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:StartTooler.Controls"
             xmlns:vm="using:StartTooler.ViewModels"
             mc:Ignorable="d"
             x:Class="StartTooler.Views.DiaryView"
             x:DataType="vm:DiaryViewModel"
             Focusable="True">

    <Grid RowDefinitions="*,Auto">

        <!-- 加载态 -->
        <Grid Grid.Row="0"
              IsVisible="{Binding IsLoading}">
            <TextBlock Text="正在整理拍摄日记…"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Tertiary}"/>
        </Grid>

        <!-- 空态 -->
        <Grid Grid.Row="0"
              IsVisible="{Binding IsEmpty}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Path Data="{DynamicResource Icon.Diary}" Width="48" Height="48"
                      Fill="{DynamicResource Text.Tertiary}" Stretch="Uniform"/>
                <TextBlock Text="暂无拍摄日记"
                           FontSize="18"
                           Foreground="{DynamicResource Text.Secondary}"/>
                <TextBlock Text="导入照片后，拍摄日记将自动按时间间隔生成。"
                           FontSize="13"
                           Foreground="{DynamicResource Text.Tertiary}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Tertiary}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Grid>

        <!-- 内容态 -->
        <Grid Grid.Row="0"
              IsVisible="{Binding IsContentVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- 上一页 -->
                <Button Grid.Column="0"
                        Classes="paging-button"
                        Command="{Binding NavigatePrevCommand}"
                        IsVisible="{Binding HasPrev}"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="上一页（←）">
                    <Path Data="{DynamicResource Icon.ChevronLeft}" Width="20" Height="20"
                          Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                </Button>

                <!-- 日记页 -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <controls:DiaryPage DataContext="{Binding}"/>
                </ScrollViewer>

                <!-- 下一页 -->
                <Button Grid.Column="2"
                        Classes="paging-button"
                        Command="{Binding NavigateNextCommand}"
                        IsVisible="{Binding HasNext}"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="下一页（→）">
                    <Path Data="{DynamicResource Icon.ChevronRight}" Width="20" Height="20"
                          Fill="{DynamicResource Text.Secondary}" Stretch="Uniform"/>
                </Button>

            </Grid>
        </Grid>

        <!-- 时间轴 -->
        <controls:TimelineBar Grid.Row="1"
                             DataContext="{Binding}"
                             IsVisible="{Binding IsContentVisible}"/>
    </Grid>
</UserControl>